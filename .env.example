# TheHand 环境变量示例
# 复制为 .env 后填写：cp .env.example .env
#
# 必填：LLM 三项（DOUBAO_*）+ 下面 TheHand 路径四项（已给 Conduit 默认示例，可按项目修改）。
# 可选：THEHAND_ROOT、SANDBOX_*、THEHAND_DISABLE_REGRESSION_GUARD、THEHAND_DISABLE_RELATIVE_IMPORT_GUARD、THEHAND_DISABLE_FORCE_TOOL_CHOICE 等见文末。

# ---------------------------------------------------------------------------
# TheHand 仓库与项目（必填；相对路径相对 THEHAND_ROOT，未设 THEHAND_ROOT 时相对仓库根）
# ---------------------------------------------------------------------------

THEHAND_SANDBOX_REPO=sandbox-repo/conduit-realworld-example-app
THEHAND_PROJECTS_DIR=projects
THEHAND_DEFAULT_PROJECT_ID=conduit

# 前端 Vite 可见，须与 THEHAND_DEFAULT_PROJECT_ID 一致
VITE_THEHAND_DEFAULT_PROJECT_ID=conduit

# 可选：显式指定 TheHand 根目录（不设则从 @thehand/core 包路径推导）
# THEHAND_ROOT=

# ---------------------------------------------------------------------------
# LLM（火山方舟 / 豆包，OpenAI 兼容 Chat Completions）
# 用于 cli-orchestrator.mjs、cli.mjs、core LLMClient
# ---------------------------------------------------------------------------

# API 地址，例如：
# https://ark.cn-beijing.volces.com/api/v3/chat/completions
DOUBAO_ENDPOINT=

# 火山方舟 API Key
DOUBAO_API_KEY=

# 推理接入点 ID（控制台「在线推理」中的 Endpoint ID）
DOUBAO_MODEL=

# 可选：每次 LLM 调用的可观测性 JSONL 路径（默认 <仓库>/data/llm-calls.jsonl，供「LLM 观测」面板读取）
# THEHAND_LLM_OBSERVABILITY_PATH=

# 设为 1 时：跳过编码写入前的「整文件退化」检测（丢失 hooks 等仍可能直到测试才暴露）
# THEHAND_DISABLE_REGRESSION_GUARD=1

# 设为 1 时：跳过「含 Outlet 的布局里相对 Tab 须在路由表注册 path」的静态校验（不推荐；关闭后可能出现 Tab 点击 404）
# THEHAND_DISABLE_OUTLET_NAV_GUARD=1

# 设为 1 时：跳过「相对 import 须在沙箱内可解析」的静态校验（不推荐；关闭后可能出现 Vite Failed to resolve import 而 vitest 仍通过）
# THEHAND_DISABLE_RELATIVE_IMPORT_GUARD=1

# 设为 1 时：关闭对 **architect / plan / test** 等 Agent 的强制 `tool_choice`（最后一轮或仅 outputTool 时），以及编码阶段的强制 `submit_files`（见 coding-agent）
# THEHAND_DISABLE_FORCE_TOOL_CHOICE=1

# ---------------------------------------------------------------------------
# Web 后端（可选，默认 3001）
# ---------------------------------------------------------------------------

PORT=3001

# ---------------------------------------------------------------------------
# Docker Sandbox（可选）
# ---------------------------------------------------------------------------

# 网络模式：none=完全隔离, bridge=允许网络访问
SANDBOX_NETWORK=none

# 内存限制
SANDBOX_MEMORY=1g

# CPU 限制
SANDBOX_CPUS=1.0
